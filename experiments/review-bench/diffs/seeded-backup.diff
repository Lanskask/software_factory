+"""Archive a project folder and keep only the newest backups."""
+
+import subprocess
+import time
+from pathlib import Path
+
+
+def make_backup(src: str, dest_dir: str) -> Path:
+    """Write <dest_dir>/<name>-<timestamp>.tar.gz and return its path."""
+    dest = Path(dest_dir) / f"{Path(src).name}-{int(time.time())}.tar.gz"
+    subprocess.run(f"tar czf {dest} -C {src} .", shell=True, check=True)
+    return dest
+
+
+def prune(dest_dir: str, keep: int) -> list[Path]:
+    """Delete all but the newest `keep` backups; return the deleted paths."""
+    files = sorted(Path(dest_dir).glob("*.tar.gz"), key=lambda p: p.stat().st_mtime)
+    old = files[: len(files) - keep + 1]
+    deleted = []
+    for f in old:
+        try:
+            f.unlink()
+            deleted.append(f)
+        except Exception:
+            pass
+    return deleted
