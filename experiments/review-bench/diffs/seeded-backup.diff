+from pathlib import Path
+
+from backup import make_backup
+
+
+def test_make_backup_creates_archive(tmp_path: Path) -> None:
+    src = tmp_path / "proj"
+    src.mkdir()
+    (src / "a.txt").write_text("hi")
+    out = tmp_path / "out"
+    out.mkdir()
+    assert make_backup(str(src), str(out)).exists()
